# ============================================================================
# Elite Solar Care CRM — environment variables
# ----------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file to a new file named ".env"   (cp .env.example .env)
#   2. Fill in values as you get them. You can leave any blank for now.
#   3. The app reads these at startup. Empty = that feature stays OFF safely.
#
# IMPORTANT: .env is git-ignored and must NEVER be committed or shared.
# When you deploy, these go into Supabase secrets / your host's env settings.
# ============================================================================

# --- Supabase (the cloud database + logins). Leave BLANK to run in local
#     demo mode with sample data and no account needed. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Square (card payments via invoices). false = payments OFF. ---
# Printing/saving receipts as PDFs works with this OFF — this switch is only
# about charging cards. Full walkthrough: PAYMENTS-AND-REMINDERS.md
VITE_PAYMENTS_ENABLED=false
# Server-side only — set these with:
#   supabase secrets set SQUARE_ACCESS_TOKEN=... SQUARE_LOCATION_ID=... SQUARE_ENVIRONMENT=sandbox
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_ENVIRONMENT=sandbox        # sandbox while testing, production when live

# --- Reminders (SMS via Twilio, Email via Resend). false = OFF. ---
VITE_SMS_ENABLED=false
VITE_EMAIL_ENABLED=false
# Server-side only — set these with:
#   supabase secrets set TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_PHONE_NUMBER=+1...
#   supabase secrets set RESEND_API_KEY=... REMINDER_FROM_EMAIL="Elite Solar Care <admin@elitesolarcare.com>"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# RESEND_API_KEY=
# REMINDER_FROM_EMAIL=
# BUSINESS_PHONE=(888) 883-3008     # appears in the reminder text
